{
  "name": "envault",
  "version": "1.15.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:envault": "ENVAULT_CLI_ACTOR_SOURCE=dev envault run --env development -- node scripts/dev.mjs",
    "generate:llms": "tsx scripts/generate-llms.ts",
    "generate:cli-tool-def": "tsx scripts/generate-cli-tool-definition.ts",
    "generate:context": "npm run generate:llms && npm run generate:cli-tool-def",
    "build": "npm run generate:context && next build",
    "build:local": "ENVAULT_CLI_ACTOR_SOURCE=build npx --yes @dinanathdash/envault@latest run --env development -- sh -c \"npm run generate:context && next build\"",
    "start": "node scripts/start.mjs",
    "start:next": "next start",
    "start:portless": "node scripts/start.mjs",
    "lint": "eslint",
    "mcp:install": "cd mcp-server && npm install",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:check": "cd mcp-server && npm run check",
    "mcp:publish": "cd mcp-server && npm publish --access public",
    "sdk:check": "cd src/lib/sdk && npm run typecheck && npm run build",
    "sdk:publish": "cd src/lib/sdk && npm publish --access public",
    "test:sdk": "tsx --test tests/agent-interceptor.test.ts",
    "test:mcp-token": "tsx --test tests/mcp-token-lifecycle.test.ts",
    "test:go": "cd cli-go && go test ./...",
    "test:all": "npm run test:sdk && npm run test:mcp-token && npm run test:go",
    "test:email": "tsx scripts/send-test-email.ts",
    "test:email:all": "tsx scripts/send-test-email.ts --all",
    "test:notification": "tsx scripts/test-notification.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.108",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@rexa-developer/tiks": "^0.3.0",
